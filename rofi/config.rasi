
configuration {
	show-icons: true;
	icon-theme: "Uniformity";
	drun-show-actions: false;

	window-format: "<b>{t}</b>\n<span weight='light' size='small'><i>{c:0}</i></span>";
	drun-display-format: "<b>{name}</b>\n[<span weight='light' size='small'><i>({generic})</i></span>]";

	eh: 2;
	markup: "bhuik";

	drun {
		display-name: "";
		scan-desktop: true;
		parse-user:   true;
		parse-system: true;
		display-prompt: "ASD";
	}

	window {
		display-name: "";
		prefer-icon-theme: true;
	}

	filebrowser {
		display-name: "";
		show-hidden: true;
		directories-first: true;
		sorting-method: "mtime";
	}

	calc {
		display-name: "";
	}

	run {
		display-name: "";
	}

	ssh {
		display-name: "";
	}

	todo {
		display-name: "";
		fallback-icon: "zim";
	}

	system {
		display-name: "";
		fallback-icon: "sys";
	}

	font: "Symbols Nerd Font, JetBrains Mono 12";

	timeout {
		delay:  10;
		action: "kb-cancel";
	}


	kb-element-next: "";
	kb-element-prev: "";

	kb-cancel: "Super+space,Escape";
	kb-mode-next: "Alt+Right,Tab";
	kb-mode-previous: "Alt+Left,ISO_Left_Tab";

	modes: [
		"drun",
		"window",
		"calc",
		"filebrowser",
		"system"
	];
}

@theme "./theme.rasi"
