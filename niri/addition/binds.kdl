binds {
	Mod+Slash	{ show-hotkey-overlay; }

	Mod+Space	hotkey-overlay-title="Show app launcher"	{ spawn-sh "pkill rofi || rofi -show drun"; }
	Mod+Return	repeat=false hotkey-overlay-title="Open a Terminal (alacritty)"	{ spawn "alacritty"; }
	
	Mod+L		hotkey-overlay-title="Lock the Screen (swaylock)"	repeat=false	{ spawn "swaylock"; }
	Mod+Shift+L	hotkey-overlay-title="Sleep (loginctl suspend)"		repeat=false	{ spawn "sh" "-c" "loginctl suspend"; }

	XF86AudioRaiseVolume	allow-when-locked=true	{ spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ +5%"; }
	XF86AudioLowerVolume	allow-when-locked=true	{ spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ -5%"; }
	XF86AudioMute			allow-when-locked=true	{ spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }

	XF86AudioMicMute			allow-when-locked=true	{ spawn-sh "pactl set-source-mute @DEFAULT_SOURCE@ toggle"; }
	
	Shift+XF86AudioRaiseVolume	allow-when-locked=true	{ spawn-sh "pactl set-source-volume @DEFAULT_SOURCE@ +5%"; }
	Shift+XF86AudioLowerVolume	allow-when-locked=true	{ spawn-sh "pactl set-source-volume @DEFAULT_SOURCE@ -5%"; }

	XF86AudioPlay				allow-when-locked=true	{ spawn-sh "playerctl play-pause"; }
	Shift+XF86AudioMute allow-when-locked=true	{ spawn-sh "playerctl play-pause"; }

	XF86AudioStop				allow-when-locked=true	{ spawn-sh "playerctl stop"; }
	XF86AudioPrev				allow-when-locked=true	{ spawn-sh "playerctl previous"; }
	XF86AudioNext				allow-when-locked=true	{ spawn-sh "playerctl next"; }

	Alt+XF86AudioRaiseVolume	allow-when-locked=true	{ spawn-sh "playerctl next"; }
	Alt+XF86AudioLowerVolume	allow-when-locked=true	{ spawn-sh "playerctl previous"; }

	XF86MonBrightnessUp		allow-when-locked=true	cooldown-ms=100	{ spawn-sh "brightnessctl set +5%"; }
	XF86MonBrightnessDown	allow-when-locked=true	cooldown-ms=100	{ spawn-sh "brightnessctl set 5%-"; }

	Mod+O	repeat=false	{ toggle-overview; }
	Mod+Q	repeat=false	{ close-window; }

	Mod+N	repeat=false	hotkey-overlay-title="Toggle Notification Layer (swaync)"		{ spawn-sh "swaync-client -R -rs && swaync-client -t"; }

	Mod+Left	{ focus-column-left; }
	Mod+Down	{ focus-window-down; }
	Mod+Up		{ focus-window-up; }
	Mod+Right	{ focus-column-right; }

	Mod+WheelScrollUp	{ focus-workspace-up; }
	Mod+WheelScrollDown	{ focus-workspace-down; }


	Mod+Ctrl+Up		{ focus-workspace-up; }
	Mod+Ctrl+Down	{ focus-workspace-down; }
	Mod+Ctrl+Left	{ focus-monitor-left; }
	Mod+Ctrl+Right	{ focus-monitor-right; }

	Mod+Shift+Up	{ move-window-up; }
	Mod+Shift+Down	{ move-window-down; }
	Mod+Shift+Left	{ consume-or-expel-window-left; }
	Mod+Shift+Right	{ consume-or-expel-window-right; }

	Mod+Ctrl+Shift+Up		{ move-window-to-workspace-up; }
	Mod+Ctrl+Shift+Down		{ move-window-to-workspace-down; }
	Mod+Ctrl+Shift+Left		{ move-window-to-monitor-left; }
	Mod+Ctrl+Shift+Right	{ move-window-to-monitor-right; }

	Mod+F			repeat=false	{ fullscreen-window; }
	Mod+Shift+F		repeat=false	{ maximize-column; }
	Mod+Alt+F			repeat=false { toggle-windowed-fullscreen; }

	Mod+R			cooldown-ms=200	{ switch-preset-column-width; }
	Mod+Shift+R		cooldown-ms=200	{ switch-preset-window-height; }

	Mod+Minus	cooldown-ms=100	{ set-column-width "-10%"; }
	Mod+Equal	cooldown-ms=100	{ set-column-width "+10%"; }

	Mod+Shift+Minus	{ set-window-height "-10%"; }
	Mod+Shift+Equal	{ set-window-height "+10%"; }

	Mod+Shift+Space	repeat=false	{ toggle-window-floating; }

	Mod+T	repeat=false	{ toggle-column-tabbed-display; }

	Print		{ screenshot; }
	Ctrl+Print	{ screenshot-screen; }
	Alt+Print	{ screenshot-window; }

	Mod+Alt+Q	{ quit; }

	Mod+P	repeat=false	{ spawn-sh "~/.config/niri/script/sunsetr-cycle.sh"; }
}
