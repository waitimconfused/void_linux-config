{
	"layer": "top",
	"position": "top",
	"height": 42,

	"start_hidden": false,

	"include": [
		"module/*.json",
		"module/**/*.json"
	],
	"margin-top": 8,
	"margin-left": 8,
	"margin-right": 8,
	"modules-left": [
		"group/system_stats",
		"niri/workspaces",
		"niri/window"
	],
	"modules-center": [
		"clock",
		"mpris",
		"custom/swaync"
	],
	"modules-right": [
		"tray",
		"group/pulseaudio",
		"group/backlight",
		"network",
		"custom/tailscale",
		"bluetooth",
		"custom/battery"
	]
}
