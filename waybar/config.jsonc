{
		"layer": "top",
		"position": "top",
		"height": 42,

		"on-sigusr1": "hide",
		"on-sigusr2": "show",
		"start_hidden": false,

		"include": [
				"module/*.json",
				"module/**/*.json"
		],
		"margin-top": 8,
		"margin-left": 8,
		"margin-right": 8,
		"modules-left": [
				"group/system_stats",
				"niri/workspaces",
				"niri/window"
		],
		"modules-center": [
				"clock",
				"mpris",
				"custom/swaync"
		],
		"modules-right": [
				"tray",
				"group/pulseaudio",
				"group/backlight",
				"network",
				"group/tailscale",
				"bluetooth",
				"custom/battery"
		]
}
